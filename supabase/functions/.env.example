# supabase/functions/.env.example  (server-side only — never committed, never VITE_)
# Used by the `generate-schedule-pdf` Edge Function (built in a later phase).

SUPABASE_SERVICE_ROLE_KEY=

# External headless-browser rendering service (e.g. Browserless).
# The Edge Function builds the schedule HTML and POSTs it here to get a PDF.
HEADLESS_PDF_API_URL=
HEADLESS_PDF_API_TOKEN=
